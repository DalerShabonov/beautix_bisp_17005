
@model List<beautix_bisp_17005.ViewModels.SubscriptionPlanViewModel>
@{
    ViewData["Title"] = "Choose Your Plan";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-semibold">Choose your Beautix plan</h1>
        <p class="text-muted fs-5">
            Subscribe once. Book beauty services across our partner salon network all month.
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row justify-content-center g-4">
        @foreach (var plan in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 @(plan.IsCurrentPlan ? "border-primary border-2" : "")">
                    @if (plan.IsCurrentPlan)
                    {
                        <div class="card-header bg-primary text-white text-center small fw-semibold">
                            Your current plan
                        </div>
                    }
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="card-title">@plan.Name</h3>
                        <div class="my-3">
                            <span class="fs-2 fw-bold">$@plan.MonthlyPrice</span>
                            <span class="text-muted">/ month</span>
                        </div>
                        <p class="text-muted">@plan.Description</p>
                        <ul class="list-unstyled mb-4">
                            <li class="mb-2">
                                &#10003;
                                @(plan.ServiceAllowance == 999
                                    ? "Unlimited services per month"
                                    : $"{plan.ServiceAllowance} services per month")
                            </li>
                            <li class="mb-2">&#10003; Access to all partner salons</li>
                            <li class="mb-2">&#10003; Online booking and cancellation</li>
                            <li class="mb-2">&#10003; Booking history and dashboard</li>
                        </ul>
                        <div class="mt-auto">
                            @if (User.Identity!.IsAuthenticated && User.IsInRole("Subscriber"))
                            {
                                if (plan.IsCurrentPlan)
                                {
                                    <button class="btn btn-outline-primary w-100" disabled>
                                        Current plan
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Activate" method="post">
                                        <input type="hidden" name="planId" value="@plan.Id" />
                                        <button type="submit" class="btn btn-primary w-100">
                                            @(plan.MonthlyPrice > 100 ? "Upgrade" : "Select Plan")
                                        </button>
                                    </form>
                                }
                            }
                            else if (!User.Identity!.IsAuthenticated)
                            {
                                <a asp-controller="Account" asp-action="Register"
                                   class="btn btn-primary w-100">
                                    Get Started
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>