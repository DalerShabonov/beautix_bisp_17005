@model List<beautix_bisp_17005.ViewModels.AdminSalonViewModel>
@{
    ViewData["Title"] = "Manage Salons";
}

<div class="section-padding">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Manage Salons</h2>
                <p class="text-muted mb-0">Approve and manage salon partners.</p>
            </div>
            <a asp-action="Index" class="btn btn-light btn-pill">
                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="card-beautix p-5 text-center">
                <h5 class="fw-bold mb-2">No salons registered yet</h5>
                <p class="text-muted mb-0">Salon partner applications will appear here.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var salon in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-beautix h-100">
                            <div style="height:140px;background:linear-gradient(135deg,#ffe4e6,#fecdd3);display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-shop text-primary" style="font-size:2.5rem;opacity:0.5;"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">@salon.SalonName</h5>
                                    @if (salon.IsApproved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </div>
                                <p class="card-text small mb-1"><i class="bi bi-geo-alt me-1"></i>@salon.District</p>
                                <p class="card-text small mb-1"><i class="bi bi-person me-1"></i>@salon.OwnerName</p>
                                <p class="card-text small text-muted mb-3"><i class="bi bi-envelope me-1"></i>@salon.OwnerEmail</p>
                                <div class="d-flex gap-2 small text-muted mb-3">
                                    <span><i class="bi bi-list-check me-1"></i>@salon.TotalServices services</span>
                                    <span class="ms-auto"><i class="bi bi-calendar-check me-1"></i>@salon.TotalBookings bookings</span>
                                </div>
                                @if (!salon.IsApproved)
                                {
                                    <form asp-action="ApproveSalon" method="post">
                                        <input type="hidden" name="salonId" value="@salon.SalonId" />
                                        <button type="submit" class="btn btn-success btn-sm w-100 btn-pill">
                                            <i class="bi bi-check-lg me-1"></i>Approve
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="SuspendSalon" method="post"
                                          onsubmit="return confirm('Suspend this salon?');">
                                        <input type="hidden" name="salonId" value="@salon.SalonId" />
                                        <button type="submit" class="btn btn-light btn-sm w-100 btn-pill text-danger">
                                            <i class="bi bi-pause-circle me-1"></i>Suspend
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
