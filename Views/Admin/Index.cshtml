@model beautix_bisp_17005.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="section-padding">
    <div class="container">
        <h2 class="fw-bold mb-1">Admin Panel</h2>
        <p class="text-muted mb-4">Platform overview and management.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @* Stats *@
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card-beautix p-4 d-flex align-items-center gap-3">
                    <div class="feature-icon mb-0" style="width:56px;height:56px;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                        <small class="text-muted">@Model.TotalSubscribers subscribers &middot; @Model.TotalSalonPartners partners</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-beautix p-4 d-flex align-items-center gap-3">
                    <div class="feature-icon mb-0" style="width:56px;height:56px;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@Model.TotalSalons</h3>
                        <small class="text-muted">
                            @Model.ApprovedSalons approved &middot;
                            @if (Model.PendingSalons > 0)
                            {
                                <span class="text-warning fw-semibold">@Model.PendingSalons pending</span>
                            }
                            else
                            {
                                <span>0 pending</span>
                            }
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-beautix p-4 d-flex align-items-center gap-3">
                    <div class="feature-icon mb-0" style="width:56px;height:56px;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@Model.TotalBookings</h3>
                        <small class="text-muted">@Model.ConfirmedBookings confirmed &middot; @Model.CancelledBookings cancelled</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="card-beautix p-4 d-flex align-items-center gap-3">
                    <div class="feature-icon mb-0" style="width:56px;height:56px;">
                        <i class="bi bi-gem"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">@Model.TotalActiveSubscriptions</h3>
                        <small class="text-muted">Active subscriptions</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-beautix p-4 d-flex align-items-center gap-3">
                    <div class="feature-icon mb-0" style="width:56px;height:56px;">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">$@Model.TotalSimulatedRevenue.ToString("N0")</h3>
                        <small class="text-muted">Simulated revenue this billing cycle</small>
                    </div>
                </div>
            </div>
        </div>

        @* Quick actions *@
        <div class="row g-4 mb-5">
            <div class="col-lg-6">
                <div class="card-beautix h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Quick Actions</h5>
                        <div class="d-grid gap-2">
                            <a asp-action="Users" asp-controller="Admin" class="btn btn-light text-start d-flex align-items-center gap-3 py-3">
                                <div class="feature-icon mb-0" style="width:40px;height:40px;font-size:1rem;"><i class="bi bi-people"></i></div>
                                <div>
                                    <div class="fw-semibold">Manage Users</div>
                                    <small class="text-muted">View and manage user accounts</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-muted"></i>
                            </a>
                            <a asp-action="Salons" asp-controller="Admin" class="btn btn-light text-start d-flex align-items-center gap-3 py-3">
                                <div class="feature-icon mb-0" style="width:40px;height:40px;font-size:1rem;"><i class="bi bi-shop"></i></div>
                                <div>
                                    <div class="fw-semibold">Manage Salons</div>
                                    <small class="text-muted">Approve and manage salon partners</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-beautix h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Recent Users</h5>
                            <a asp-action="Users" class="btn btn-sm btn-light">View all</a>
                        </div>
                        @if (!Model.RecentUsers.Any())
                        {
                            <p class="text-muted small mb-0">No users yet.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var user in Model.RecentUsers)
                                {
                                    <div class="d-flex align-items-center gap-3 pb-3 border-bottom">
                                        <div class="avatar-circle flex-shrink-0">@(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName[0].ToString())</div>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="small fw-semibold text-truncate">@user.FullName</div>
                                            <div class="small text-muted text-truncate">@user.Email &bull; @user.RegisteredAt.ToString("dd MMM yyyy")</div>
                                        </div>
                                        <span class="badge bg-light text-dark">@user.Role</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Pending salons *@
        @if (Model.PendingSalonList.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">
                    Salons awaiting approval
                    <span class="badge bg-warning text-dark ms-2">@Model.PendingSalonList.Count</span>
                </h4>
                <a asp-action="Salons" class="btn btn-sm btn-light">View all salons</a>
            </div>
            <div class="card-beautix">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Salon</th>
                                    <th>Owner</th>
                                    <th>District</th>
                                    <th>Services</th>
                                    <th class="pe-4"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var salon in Model.PendingSalonList)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">@salon.SalonName</td>
                                        <td>
                                            @salon.OwnerName
                                            <br /><small class="text-muted">@salon.OwnerEmail</small>
                                        </td>
                                        <td>@salon.District</td>
                                        <td>@salon.TotalServices</td>
                                        <td class="pe-4 text-end">
                                            <form asp-action="ApproveSalon" method="post" class="d-inline">
                                                <input type="hidden" name="salonId" value="@salon.SalonId" />
                                                <button type="submit" class="btn btn-sm btn-success btn-pill">
                                                    <i class="bi bi-check-lg me-1"></i>Approve
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
