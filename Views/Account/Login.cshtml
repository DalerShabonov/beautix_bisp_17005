@model beautix_bisp_17005.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="section-padding">
    <div class="container">
        <div class="auth-card animate-fade-in">
            <div class="auth-header">
                <div class="feature-icon mx-auto mb-3" style="width:56px;height:56px;">
                    <i class="bi bi-person-circle" style="font-size:1.75rem;"></i>
                </div>
                <h2>Welcome Back</h2>
                <p>Sign in to manage your bookings and discover new salons.</p>
            </div>

            <form method="post" asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Email"><i class="bi bi-envelope me-2 text-muted"></i>Email address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Password" />
                    <label asp-for="Password"><i class="bi bi-lock me-2 text-muted"></i>Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                    </div>
                    <a href="#" class="text-primary small text-decoration-none">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-pill py-2 mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>

                <div class="text-center">
                    <span class="text-muted">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none ms-1">Get Started</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
