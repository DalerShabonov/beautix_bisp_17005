@{
    ViewData["Title"] = "Access Denied";
}

<div class="section-padding">
    <div class="container">
        <div class="text-center py-5">
            <div class="feature-icon mx-auto mb-4" style="width:80px;height:80px;font-size:2.5rem;">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4 mx-auto" style="max-width:400px;">You don't have permission to access this page. Please contact an administrator if you believe this is an error.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-pill px-4">
                <i class="bi bi-house-door me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>
