<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beautix</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/beautix_bisp_17005.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-beautix fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-stars brand-icon"></i>
                <span class="brand-text">Beautix</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        @if (User.IsInRole("Subscriber"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subscription" asp-action="Plans">
                                    <i class="bi bi-gem me-1"></i>Plans
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subscription" asp-action="Dashboard">
                                    <i class="bi bi-person-badge me-1"></i>My Subscription
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Booking" asp-action="Browse">
                                    <i class="bi bi-calendar-check me-1"></i>Book a Service
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Booking" asp-action="MyBookings">
                                    <i class="bi bi-journal-bookmark me-1"></i>My Bookings
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("SalonPartner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Salon" asp-action="Dashboard">
                                    <i class="bi bi-shop me-1"></i>Salon Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin Panel
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-dropdown" href="#" role="button" data-bs-toggle="dropdown">
                                <div class="avatar-circle">@User.Identity.Name?[0]</div>
                                <span class="ms-2 d-none d-lg-inline">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary btn-pill" asp-controller="Account" asp-action="Register">
                                Get Started
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-beautix">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-stars brand-icon text-white"></i>
                        <span class="footer-brand">Beautix</span>
                    </div>
                    <p class="footer-text">Discover and book the best beauty services near you. From hair styling to spa treatments, your glow-up starts here.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Discover</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Booking" asp-action="Browse">Services</a></li>
                        <li><a asp-controller="Subscription" asp-action="Plans">Pricing</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Account</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                        <li><a asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-heading">Stay Updated</h6>
                    <p class="footer-text">Get notified about new salons and exclusive deals.</p>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Your email">
                        <button class="btn btn-light" type="button"><i class="bi bi-arrow-right"></i></button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Beautix. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
