@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="section-padding">
    <div class="container">
        <div class="text-center py-5">
            <div class="feature-icon mx-auto mb-4" style="width:80px;height:80px;font-size:2.5rem;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h2 class="fw-bold mb-2">Oops! Something went wrong</h2>
            <p class="text-muted mb-4 mx-auto" style="max-width:400px;">An error occurred while processing your request. Please try again later or contact support if the problem persists.</p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-pill px-4">
                <i class="bi bi-house-door me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>
