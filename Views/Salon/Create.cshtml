@model beautix_bisp_17005.ViewModels.SalonCreateViewModel
@{
    ViewData["Title"] = "Register Your Salon";
}

<div class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card-beautix p-4 p-md-5 animate-fade-in">
                    <h3 class="fw-bold mb-1">Register Your Salon</h3>
                    <p class="text-muted mb-4">
                        Set up your salon profile to start accepting bookings. Your salon will be reviewed and approved by our team.
                    </p>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form asp-action="Create" method="post">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Salon Lumiere" />
                                    <label asp-for="Name"><i class="bi bi-shop me-2 text-muted"></i>Salon Name</label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Address" class="form-control" placeholder="Street address" />
                                    <label asp-for="Address"><i class="bi bi-geo-alt me-2 text-muted"></i>Street Address</label>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="District" class="form-select">
                                        <option value="">Select district</option>
                                        <option>Yunusabad</option>
                                        <option>Chilanzar</option>
                                        <option>Mirzo Ulugbek</option>
                                        <option>Shaykhantahur</option>
                                        <option>Yakkasaray</option>
                                        <option>Almazar</option>
                                    </select>
                                    <label asp-for="District">District</label>
                                    <span asp-validation-for="District" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ContactEmail" type="email" class="form-control" placeholder="salon@example.com" />
                                    <label asp-for="ContactEmail"><i class="bi bi-envelope me-2 text-muted"></i>Contact Email</label>
                                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ContactPhone" class="form-control" placeholder="+998 XX XXX XX XX" />
                                    <label asp-for="ContactPhone"><i class="bi bi-telephone me-2 text-muted"></i>Contact Phone</label>
                                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Description" class="form-control" placeholder="Description" style="height:120px;"></textarea>
                                    <label asp-for="Description">Salon Description</label>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-pill px-4">
                                <i class="bi bi-check-lg me-2"></i>Submit for Approval
                            </button>
                            <a asp-action="Dashboard" class="btn btn-light btn-pill px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
