@model List<beautix_bisp_17005.ViewModels.BookingListViewModel>
@using beautix_bisp_17005.Models.Entities
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-semibold mb-0">My Bookings</h1>
        <a asp-action="Browse" class="btn btn-primary">
            Book a Service
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 bg-light p-4 text-center">
            <h5 class="mb-2">No bookings yet</h5>
            <p class="text-muted mb-3">
                You have not made any bookings yet.
                Browse our partner salons to get started.
            </p>
            <a asp-action="Browse" class="btn btn-primary px-4">
                Browse Salons
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Service</th>
                            <th>Salon</th>
                            <th>Date &amp; Time</th>
                            <th>Credits</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td class="align-middle">
                                    <strong>@booking.ServiceName</strong>
                                </td>
                                <td class="align-middle text-muted">
                                    @booking.SalonName
                                </td>
                                <td class="align-middle">
                                    @booking.AppointmentDate.ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-primary">
                                        @booking.CreditsRequired
                                    </span>
                                </td>
                                <td class="align-middle">
                                    @{
                                        var badgeClass = booking.Status switch
                                        {
                                            BookingStatus.Confirmed => "bg-success",
                                            BookingStatus.Cancelled => "bg-secondary",
                                            BookingStatus.Completed => "bg-primary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        @booking.Status
                                    </span>
                                </td>
                                <td class="align-middle text-end">
                                    @if (booking.CanCancel)
                                    {
                                        <form asp-action="Cancel" method="post"
                                              onsubmit="return confirm('Are you sure you want to cancel this booking? Your credit will be reinstated.');">
                                            <input type="hidden"
                                                   name="bookingId"
                                                   value="@booking.BookingId" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>