@model List<beautix_bisp_17005.ViewModels.BookingListViewModel>
@using beautix_bisp_17005.Models.Entities
@{
    ViewData["Title"] = "My Bookings";
    var upcoming = Model.Where(b => b.Status == BookingStatus.Confirmed).ToList();
    var past = Model.Where(b => b.Status != BookingStatus.Confirmed).ToList();
}

<div class="section-padding">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">My Bookings</h2>
                <p class="text-muted mb-0">Manage your upcoming and past appointments.</p>
            </div>
            <a asp-action="Browse" class="btn btn-primary btn-pill">
                <i class="bi bi-plus-lg me-1"></i>Book a Service
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="card-beautix p-5 text-center">
                <div class="feature-icon mx-auto mb-3" style="width:64px;height:64px;font-size:2rem;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-bold mb-2">No bookings yet</h5>
                <p class="text-muted mb-3">You have not made any bookings yet. Browse our partner salons to get started.</p>
                <div>
                    <a asp-action="Browse" class="btn btn-primary btn-pill px-4">Browse Salons</a>
                </div>
            </div>
        }
        else
        {
            <ul class="nav nav-pills mb-4" id="bookingTabs">
                <li class="nav-item">
                    <button class="nav-link active btn-pill" data-bs-toggle="tab" data-bs-target="#upcoming">
                        Upcoming <span class="badge bg-light text-dark ms-1">@upcoming.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-pill" data-bs-toggle="tab" data-bs-target="#past">
                        Past <span class="badge bg-light text-dark ms-1">@past.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="upcoming">
                    @if (!upcoming.Any())
                    {
                        <div class="card-beautix p-4 text-center">
                            <p class="text-muted mb-0">No upcoming bookings.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var booking in upcoming)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card-beautix h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <span class="badge bg-success">Confirmed</span>
                                                <span class="badge bg-light text-dark">@booking.CreditsRequired credit@(booking.CreditsRequired > 1 ? "s" : "")</span>
                                            </div>
                                            <h5 class="fw-bold mb-1">@booking.SalonName</h5>
                                            <p class="text-muted small mb-3">@booking.ServiceName</p>
                                            <div class="d-flex align-items-center gap-2 text-muted small mb-1">
                                                <i class="bi bi-calendar"></i>
                                                <span>@booking.AppointmentDate.ToString("dd MMM yyyy")</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                                                <i class="bi bi-clock"></i>
                                                <span>@booking.AppointmentDate.ToString("HH:mm")</span>
                                            </div>
                                            @if (booking.CanCancel)
                                            {
                                                <form asp-action="Cancel" method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this booking? Your credit will be reinstated.');">
                                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                    <button type="submit" class="btn btn-light btn-sm w-100 text-danger">
                                                        <i class="bi bi-x-circle me-1"></i>Cancel Booking
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-light btn-sm w-100" disabled>
                                                    <i class="bi bi-lock me-1"></i>Cannot cancel (within 24h)
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="past">
                    @if (!past.Any())
                    {
                        <div class="card-beautix p-4 text-center">
                            <p class="text-muted mb-0">No past bookings.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var booking in past)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card-beautix h-100 opacity-75">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                @{
                                                    var (badgeClass, badgeText) = booking.Status switch
                                                    {
                                                        BookingStatus.Cancelled => ("bg-secondary", "Cancelled"),
                                                        BookingStatus.Completed => ("bg-primary", "Completed"),
                                                        _ => ("bg-light text-dark", booking.Status.ToString())
                                                    };
                                                }
                                                <span class="badge @badgeClass">@badgeText</span>
                                            </div>
                                            <h5 class="fw-bold mb-1">@booking.SalonName</h5>
                                            <p class="text-muted small mb-3">@booking.ServiceName</p>
                                            <div class="d-flex align-items-center gap-2 text-muted small mb-1">
                                                <i class="bi bi-calendar"></i>
                                                <span>@booking.AppointmentDate.ToString("dd MMM yyyy")</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 text-muted small mb-0">
                                                <i class="bi bi-clock"></i>
                                                <span>@booking.AppointmentDate.ToString("HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
