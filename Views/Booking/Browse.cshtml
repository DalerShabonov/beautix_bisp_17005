@model List<beautix_bisp_17005.ViewModels.SalonBrowseViewModel>
@{
    ViewData["Title"] = "Browse Services";
}

<section class="hero-section" style="padding:3rem 0;">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Find Your Perfect <span class="text-gradient">Service</span></h2>
            <p class="text-muted">Browse our partner salons and book a service in seconds.</p>
        </div>
    </div>
</section>

<section class="section-padding pt-0">
    <div class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="card-beautix p-5 text-center">
                <h5 class="fw-bold mb-2">No salons available yet</h5>
                <p class="text-muted mb-0">Our partner salon network is growing. Please check back soon.</p>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0 fw-bold">@Model.Sum(s => s.Services.Count) Services Available</h5>
                <span class="text-muted small">@Model.Count partner salon@(Model.Count == 1 ? "" : "s")</span>
            </div>

            @foreach (var salon in Model)
            {
                <div class="card-beautix mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3 pb-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:56px;height:56px;background:linear-gradient(135deg,#ffe4e6,#fecdd3);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-shop text-primary" style="font-size:1.5rem;"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1">@salon.SalonName</h5>
                                    <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i>@salon.District &mdash; @salon.Address</p>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(salon.Description))
                        {
                            <p class="text-muted small mb-3">@salon.Description</p>
                        }

                        @if (!salon.Services.Any())
                        {
                            <p class="text-muted small mb-0">No services currently listed for this salon.</p>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var service in salon.Services)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card-beautix h-100 p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="fw-bold mb-0">@service.ServiceName</h6>
                                                <span class="badge bg-primary">@service.CreditsRequired credit@(service.CreditsRequired > 1 ? "s" : "")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(service.Description))
                                            {
                                                <p class="text-muted small mb-2">@service.Description</p>
                                            }
                                            <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                                                <span><i class="bi bi-clock me-1"></i>@service.DurationMinutes min</span>
                                                <span class="ms-auto fw-bold text-primary">$@service.Price</span>
                                            </div>
                                            <a asp-action="Book" asp-route-serviceId="@service.ServiceId" class="btn btn-primary btn-sm w-100 btn-pill">
                                                <i class="bi bi-calendar-check me-1"></i>Book Now
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>
