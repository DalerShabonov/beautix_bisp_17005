@model beautix_bisp_17005.ViewModels.BookingCreateViewModel
@{
    ViewData["Title"] = "Confirm Booking";
}

<div class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card-beautix p-4 p-md-5 animate-fade-in">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div style="width:64px;height:64px;background:linear-gradient(135deg,#ffe4e6,#fecdd3);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-shop text-primary" style="font-size:1.75rem;"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@Model.SalonName</h4>
                            <p class="text-muted mb-0"><i class="bi bi-stars me-1"></i>Confirm your appointment</p>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <h5 class="fw-bold mb-3">Service Details</h5>
                    <div class="bg-soft rounded-3 p-4 mb-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <p class="text-muted small mb-1">Service</p>
                                <p class="fw-semibold mb-0">@Model.ServiceName</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Duration</p>
                                <p class="fw-semibold mb-0"><i class="bi bi-clock me-1"></i>@Model.DurationMinutes minutes</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Credits required</p>
                                <p class="fw-semibold mb-0">
                                    <span class="badge bg-primary">@Model.CreditsRequired credit@(Model.CreditsRequired > 1 ? "s" : "")</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Book" method="post">
                        <input type="hidden" asp-for="ServiceId" />
                        <input type="hidden" asp-for="ServiceName" />
                        <input type="hidden" asp-for="SalonName" />
                        <input type="hidden" asp-for="CreditsRequired" />
                        <input type="hidden" asp-for="DurationMinutes" />

                        <h5 class="fw-bold mb-3">Select Date & Time</h5>
                        <div class="form-floating mb-3">
                            <input asp-for="AppointmentDate" type="datetime-local" class="form-control"
                                   value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")"
                                   min="@DateTime.UtcNow.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                            <label asp-for="AppointmentDate"><i class="bi bi-calendar-event me-2 text-muted"></i>Appointment Date and Time</label>
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <p class="text-muted small mb-4">
                            <i class="bi bi-info-circle me-1"></i>
                            Bookings can be cancelled up to 24 hours before the appointment.
                        </p>

                        <div class="d-flex gap-3 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg btn-pill flex-grow-1">
                                <i class="bi bi-calendar-check me-2"></i>Confirm Booking
                            </button>
                            <a asp-action="Browse" class="btn btn-light btn-pill px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
